# ── Database ────────────────────────────────────────────────────────────────
# db.ts picks one of these from APP_MODE and throws at boot if the chosen one is missing.
DATABASE_URL_PROD=postgres://user:password@127.0.0.1:5432/kdip
DATABASE_URL_SANDBOX=postgres://user:password@127.0.0.1:5432/kdip_sandbox

# "sandbox" uses DATABASE_URL_SANDBOX, anything else (or unset) is production.
APP_MODE=production

# ── Auth ────────────────────────────────────────────────────────────────────
# Signing key for the 9h JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars

# Email OTP second factor for Clinic accounts. Anything other than "true" turns
# it off — the server logs a warning at boot when it is off. OTPs live in memory
# and are lost on restart.
ENABLE_OTP=true

# ── Replenishment mail ("Andon") ─────────────────────────────────────────────
EMAIL_USER=store.manager@example.com
EMAIL_PASS=app-password
STOR_MANAGER_EMAIL=district.store@example.com

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
